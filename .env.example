# AtlasShare environment variables
#
# Copy this file to .env (never commit .env) and fill in real values.
# All variables are server-side unless prefixed with NEXT_PUBLIC_.

# Public origin of the running app. Used for metadata and auth callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Neon PostgreSQL
# DATABASE_URL is the pooled connection used by the app at runtime.
# DIRECT_URL is the direct (non-pooled) connection used only by Prisma migrations.
# Local development: any Postgres works (for example
# postgresql://USER@localhost:5432/atlasshare_dev). DATABASE_URL and DIRECT_URL
# may be the same URL locally.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth
# Generate with: openssl rand -base64 32
# BETTER_AUTH_URL and NEXT_PUBLIC_APP_URL must match the real origin.
BETTER_AUTH_SECRET="replace-me-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Brevo transactional email
# Create an API key at https://app.brevo.com/settings/keys/api
# Add and verify a sender under Settings → Senders, Domains & IPs → Senders
# (a 6-digit code is sent to that address). A domain purchase is not required
# for a practice project, but an authenticated domain gives better deliverability.
# Leave BREVO_API_KEY empty to disable sending (sign-up and reset still work).
BREVO_API_KEY=""
EMAIL_FROM="AtlasShare <your-verified-sender@example.com>"

# Optional: dedicated database for integration tests.
# Never point this at production data.
TEST_DATABASE_URL=""
